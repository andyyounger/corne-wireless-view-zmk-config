#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

&mt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

// Mouse move: faster ramp (150ms), less aggressive acceleration
&mmv {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <1>;
};

// Mouse scroll: faster ramp, linear
&msc {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        graveesc: graveesc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspdel: bspace_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
        };

        // Custom behavior (see src/behavior_esc_to_base.c): sends ESC and
        // forces the default layer, cancelling any layer locked via the
        // stick keys.
        esc_to_base: esc_to_base {
            compatible = "zmk,behavior-esc-to-base";
            #binding-cells = <0>;
        };

        lt_bspdel: layer_tap_bspc_del {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BACKSPACE_DELETE";
            #binding-cells = <2>;
            bindings = <&mo>, <&bspdel>;

            tapping-term-ms = <280>;
            quick-tap-ms = <250>;
        };

        td_lctrl_quote: td_lctrl_quote {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_GUI_ENTER";
            #binding-cells = <0>;
            bindings = <&mt LEFT_CONTROL SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
        };

        td_alt_brckt_bslsh: td_alt_brckt_bslsh {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_BRCKT_BSLSH";
            #binding-cells = <0>;
            bindings =
                <&mt LEFT_ALT LEFT_BRACKET>,
                <&kp RIGHT_BRACKET>,
                <&kp BACKSLASH>;
        };

        td_alt_minus_grave_esc: td_alt_minus_grave_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_MINUS_GRAVE_ESC";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT MINUS>, <&kp GRAVE>, <&kp ESCAPE>;
        };

        lhmini: lhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 5 4 27 28 26 25 24 30 29 31 32 33 34 35 23 11 10 9 8 7 6 12 37 36 38 39 40 41 18 19 20 21 22 23 17>;
            label = "LHMINI";
            hold-trigger-on-release;
        };

        rhmini: rhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <12 13 14 15 16 17 24 25 26 27 28 29 0 1 2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 3 6 7 8 9 10 11 18 23 30 31 32 33 34 35 39 40 41>;
            label = "RHMINI";
            hold-trigger-on-release;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        bootloader {
            bindings = <&bootloader>;
            key-positions = <4 3 29 5>;
        };

        thumbesc {
            bindings = <&esc_to_base>;
            key-positions = <38 39>;
            timeout-ms = <150>;
        };
        capsword {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <15 16 19 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // "Stick" keys (outermost thumb key on each side): while holding an &lt
        // key, tap one to lock the held layer; tap it again to unlock (back to base).

        // 0

        default_layer {
            display-name = "Base";
            bindings = <
&kp N0  &kp Q               &kp W               &kp E                   &kp R                 &kp T        &kp Y        &kp U                  &kp I                    &kp O               &kp P                       &kp NUMBER_0
&trans  &lhmini LEFT_WIN A  &lhmini LEFT_ALT S  &lhmini LEFT_CONTROL D  &lhmini LEFT_SHIFT F  &kp G        &kp H        &rhmini RIGHT_SHIFT J  &rhmini RIGHT_CONTROL K  &rhmini LEFT_ALT L  &rhmini LEFT_WIN SEMICOLON  &trans
&trans  &kp Z               &kp X               &kp C                   &kp V                 &kp B        &kp N        &kp M                  &kp COMMA                &kp DOT             &kp FSLH                    &trans
                                                &trans                  &lt 4 TAB             &lt 2 RET    &lt 1 SPACE  &lt_bspdel 3 BSPC      &trans
            >;
        };

        // 1

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp NUMBER_1  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6    &kp N7         &kp N8     &kp N9     &kp N0  &kp NUMBER_1
&trans        &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN       &kp UP     &kp RIGHT  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp PAGE_DOWN  &kp PG_UP  &kp END    &trans  &trans
                              &tog 1  &trans  &trans    &trans    &trans         &tog 1
            >;
        };

        // 2

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp NUMBER_2  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp NUMBER_2
&trans        &trans    &trans  &trans    &trans    &kp GRAVE    &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &trans
&trans        &trans    &trans  &trans    &trans    &kp TILDE    &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &trans
                                &tog 2    &trans    &trans       &trans     &trans     &tog 2
            >;
        };

        // 3:

        extra {
            display-name = "Extra";
            bindings = <
&kp NUMBER_3  &trans  &trans  &trans  &trans	&trans		&trans			&trans			&trans			&trans			&trans  &kp NUMBER_3
&trans        &trans  &trans  &trans  &trans	&trans		&mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP	&mmv MOVE_RIGHT &trans  &trans
&trans        &trans  &trans  &trans  &trans	&trans		&trans			&msc SCRL_DOWN	&msc SCRL_UP	&trans			&trans  &trans
                              &tog 3  &mkp MB1  &mkp MB2    &mkp MB1		&mkp MB2		&tog 3
            >;
        };

        // 4

        funcr {
            display-name = "funcright";
            bindings = <
&kp NUMBER_4  &trans  &trans  &trans  &trans  &trans    &kp F9  &kp F10  &kp F11  &kp F12  &kp SYSREQ       &kp NUMBER_4
&trans        &trans  &trans  &trans  &trans  &trans    &kp F5  &kp F6   &kp F7   &kp F8   &kp SCROLLLOCK   &trans
&trans        &trans  &trans  &trans  &trans  &trans    &kp F1  &kp F2   &kp F3   &kp F4   &kp PRINTSCREEN  &trans
                              &tog 4  &trans  &trans    &trans  &trans   &tog 4
            >;
        };

        // 5

        special {
            display-name = "special";
            bindings = <
&kp N5      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &kp SYSREQ
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &kp SCROLLLOCK
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &kp PRINTSCREEN
                                        &tog 5        &trans        &trans          &trans  &trans  &tog 5
            >;
        };

        // EMPTY 
        // &trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
        // &trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
        // &trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
        //                                         &trans        &trans        &trans          &trans  &trans  &trans
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
