#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

&mt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

// Mouse move: faster ramp (150ms), less aggressive acceleration

&mmv {
    time-to-max-speed-ms = <250>;
    acceleration-exponent = <2>;
};

// Mouse scroll: faster ramp, linear

&msc {
    time-to-max-speed-ms = <250>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        graveesc: graveesc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspdel: bspace_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
        };

        // Custom behavior (see src/behavior_esc_to_base.c): sends ESC and
        // forces the default layer, cancelling any layer locked via the
        // stick keys.

        esc_to_base: esc_to_base {
            compatible = "zmk,behavior-esc-to-base";
            #binding-cells = <0>;
        };

        lt_bspdel: layer_tap_bspc_del {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BACKSPACE_DELETE";
            #binding-cells = <2>;
            bindings = <&mo>, <&bspdel>;

            tapping-term-ms = <280>;
            quick-tap-ms = <250>;
        };

        td_lctrl_quote: td_lctrl_quote {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_GUI_ENTER";
            #binding-cells = <0>;
            bindings = <&mt LCTRL SQT>, <&kp DQT>;
        };

        td_alt_brckt_bslsh: td_alt_brckt_bslsh {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_BRCKT_BSLSH";
            #binding-cells = <0>;
            bindings = <&mt LALT LBKT>, <&kp RBKT>, <&kp BSLH>;
        };

        td_alt_minus_grave_esc: td_alt_minus_grave_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_MINUS_GRAVE_ESC";
            #binding-cells = <0>;
            bindings = <&mt LALT MINUS>, <&kp GRAVE>, <&kp ESC>;
        };

        lhmini: lhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 5 4 27 28 26 25 24 30 29 31 32 33 34 35 23 11 10 9 8 7 6 12 37 36 38 39 40 41 18 19 20 21 22 23 17>;
            label = "LHMINI";
            hold-trigger-on-release;
        };

        rhmini: rhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <12 13 14 15 16 17 24 25 26 27 28 29 0 1 2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 3 6 7 8 9 10 11 18 23 30 31 32 33 34 35 39 40 41>;
            label = "RHMINI";
            hold-trigger-on-release;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // R E B T

        bootloader {
            bindings = <&bootloader>;
            key-positions = <4 3 29 5>;
        };

        // RET SPACE (both inner thumbs): ESC and force default layer.

        thumbesc {
            bindings = <&esc_to_base>;
            key-positions = <38 39>;
            timeout-ms = <150>;
        };

        // F J

        capsword {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        // D F J K

        caps {
            bindings = <&kp CAPS>;
            key-positions = <15 16 19 20>;
        };

        // B T C

        btclear {
            bindings = <&bt BT_CLR>;
            key-positions = <5 29 27>;
        };

        // B T Q

        bt1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 29 1>;
        };

        // B T W

        bt2 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <5 29 2>;
        };

        // B T E

        bt3 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <5 29 3>;
        };

        // B T R

        bt4 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <5 29 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // "Stick" keys (outermost thumb key on each side): while holding an &lt
        // key, tap one to lock the held layer; tap it again to unlock (back to base).
        // 0

        default_layer {
            display-name = "Base";
            bindings = <
&trans  &kp Q           &kp W           &kp E            &kp R             &kp T        &kp Y        &kp U              &kp I            &kp O           &kp P                   &trans
&trans  &lhmini LGUI A  &lhmini LALT S  &lhmini LCTRL D  &lhmini LSHIFT F  &kp G        &kp H        &rhmini RSHIFT J   &rhmini RCTRL K  &rhmini LALT L  &rhmini LGUI SEMICOLON  &trans
&trans  &kp Z           &kp X           &kp C            &kp V             &kp B        &kp N        &kp M              &kp COMMA        &kp DOT         &kp FSLH                &trans
                                        &lt 3 ESC        &lt 4 TAB         &lt 2 RET    &lt 1 SPACE  &lt_bspdel 2 BSPC  &lt 5 ESCAPE
            >;
        };

        // 1

        lower_layer {
            display-name = "Lower";
            bindings = <
&tog 1  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6    &kp N7     &kp N8     &kp N9     &kp N0  &tog 1
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans
                        &trans  &trans  &trans    &trans    &trans     &trans
            >;
        };

        // 2

        raise_layer {
            display-name = "Raise";
            bindings = <
&tog 2  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &tog 2
&trans  &trans    &trans  &trans    &trans    &kp GRAVE    &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &trans
&trans  &trans    &trans  &trans    &trans    &kp TILDE    &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &trans
                          &trans    &trans    &trans       &trans     &trans     &trans
            >;
        };

        // 3:

        extra {
            display-name = "Extra";
            bindings = <
&tog 3  &kp K_VOL_DN  &kp C_BRI_DN  &trans  &trans    &trans      &trans          &trans          &trans        &trans           &trans  &tog 3
&trans  &kp K_VOL_UP  &kp C_BRI_UP  &trans  &trans    &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &kp K_MUTE    &trans        &trans  &trans    &trans      &trans          &msc SCRL_DOWN  &msc SCRL_UP  &trans           &trans  &trans
                                    &trans  &mkp MB1  &mkp MB2    &mkp MB1        &mkp MB2        &trans
            >;
        };

        // 4

        funcr {
            display-name = "funcright";
            bindings = <
&tog 4  &trans  &trans  &trans  &trans  &trans    &kp F9  &kp F10  &kp F11  &kp F12  &kp SYSREQ  &tog 4
&trans  &trans  &trans  &trans  &trans  &trans    &kp F5  &kp F6   &kp F7   &kp F8   &kp SLCK    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp F1  &kp F2   &kp F3   &kp F4   &kp PSCRN   &trans
                        &trans  &trans  &trans    &trans  &trans   &trans
            >;
        };

        // 5

        lnum {
            display-name = "lnum";
            bindings = <
&tog 5  &trans  &kp N7  &kp N8  &kp N9  &kp N0         &trans  &trans  &trans  &trans  &trans  &tog 5
&trans  &trans  &kp N4  &kp N5  &kp N6  &kp MINUS      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &kp KP_PLUS    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans         &trans  &trans  &trans
            >;
        };

        // EMPTY 
        //     &trans  &trans          &trans          &trans           &trans            &trans                       &trans          &trans            &trans             &trans           &trans                  &trans
        //     &trans  &trans          &trans          &trans           &trans            &trans                       &trans          &trans            &trans             &trans           &trans                  &trans
        //     &trans  &trans          &trans          &trans           &trans            &trans                       &trans          &trans            &trans             &trans           &trans                  &trans
        //                             &trans          &trans           &trans                                                         &trans            &trans             &trans
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
