 *
 * SPDX-License-Identifier: MIT
 *
 * Synced with the lily58 config (lily58-wireless): 4 layers total.
 *
 *   0 Base        QWERTY + per-key modifiers (identical to the lily)
 *   1 Sym         symbols spread across BOTH halves, so either thumb can
 *                 be paired with either hand
 *   2 cursornum   numpad (left) + arrows/mouse (right) + MB1/MB2 thumbs
 *   3 funcr       F-keys, mirrored: F9-F12/F5-F8/F1-F4 on both halves
 *
 * Thumb keys (2 live per side, outer thumbs unused):
 *   [Left]  &lt 1 TAB    &lt 3 RET
 *   [Right] &lt 2 SPACE  &lt_bspdel 1 BSPDEL
 *
 * Outer columns are used as on the lily:
 *   base:   &mt LCTRL ESCAPE / &mt RCTRL ENTER (row 2), &kp LSHFT / &kp RSHFT (row 3)
 *   layers: &tog <layer> lock keys at both ends of the qwerty row (row 0),
 *           matching the lily's qwerty row (row 1) positionally.
 *   While holding an &lt thumb key, tap an outer &tog key to lock the held
 *   layer; tap it again to unlock (back to base).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

&mt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

// Mouse move: faster ramp (150ms), less aggressive acceleration

&mmv {
    time-to-max-speed-ms = <250>;
    acceleration-exponent = <2>;
};

// Mouse scroll: faster ramp, linear

&msc {
    time-to-max-speed-ms = <250>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        graveesc: graveesc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspdel: bspace_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
        };

        // Custom behavior (see src/behavior_esc_to_base.c): sends ESC and
        // forces the default layer, cancelling any layer locked via the
        // stick keys.

        esc_to_base: esc_to_base {
            compatible = "zmk,behavior-esc-to-base";
            #binding-cells = <0>;
        };

        lt_bspdel: layer_tap_bspc_del {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BACKSPACE_DELETE";
            #binding-cells = <2>;
            bindings = <&mo>, <&bspdel>;

            tapping-term-ms = <280>;
            quick-tap-ms = <250>;
        };

        td_lctrl_quote: td_lctrl_quote {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_GUI_ENTER";
            #binding-cells = <0>;
            bindings = <&mt LCTRL SQT>, <&kp DQT>;
        };

        td_alt_brckt_bslsh: td_alt_brckt_bslsh {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_BRCKT_BSLSH";
            #binding-cells = <0>;
            bindings = <&mt LALT LBKT>, <&kp RBKT>, <&kp BSLH>;
        };

        td_alt_minus_grave_esc: td_alt_minus_grave_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_MINUS_GRAVE_ESC";
            #binding-cells = <0>;
            bindings = <&mt LALT MINUS>, <&kp GRAVE>, <&kp ESC>;
        };

        lhmini: lhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 5 4 27 28 26 25 24 30 29 31 32 33 34 35 23 11 10 9 8 7 6 12 37 36 38 39 40 41 18 19 20 21 22 23>;
            label = "LHMINI";
            hold-trigger-on-release;
        };

        rhmini: rhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <12 13 14 15 16 17 24 25 26 27 28 29 0 1 2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 3 6 7 8 9 10 11 23 30 31 32 33 34 35 39 40 41>;
            label = "RHMINI";
            hold-trigger-on-release;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // R E B T

        bootloader {
            bindings = <&bootloader>;
            key-positions = <4 3 29 5>;
        };

        // RET SPACE (both inner thumbs): ESC and force default layer.

        thumbesc {
            bindings = <&esc_to_base>;
            key-positions = <38 39>;
            timeout-ms = <150>;
        };

        // F J

        capsword {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        // D F J K

        caps {
            bindings = <&kp CAPS>;
            key-positions = <15 16 19 20>;
        };

        // B T C

        btclear {
            bindings = <&bt BT_CLR>;
            key-positions = <5 29 27>;
        };

        // B T Q

        bt1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 29 1>;
        };

        // B T W

        bt2 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <5 29 2>;
        };

        // B T E

        bt3 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <5 29 3>;
        };

        // B T R

        bt4 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <5 29 4>;
        };

        // B T O: toggle output between USB (dongle) and BLE (active profile's host)

        btout {
            bindings = <&out OUT_TOG>;
            key-positions = <5 29 9>;
        };

        // B T Z: same as B T O, one-handed (left) variant

        btz {
            bindings = <&out OUT_TOG>;
            key-positions = <5 29 25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Key position order per row:
        //   row0 (qwerty): 0-11  (0/11 outer, used as &tog locks on layers)
        //   row1 (asdf):   12-23 (12/23 outer)
        //   row2 (zxcv):   24-35 (24/35 outer)
        //   row3 (thumbs): 36-38 | 39-41

        base {
            // |      |  Q   |  W   |  E   |  R   |  T   |          |  Y   |  U   |  I   |  O   |  P   | Bspc |
            // | C-Esc|  A   |  S   |  D   |  F   |  G   |          |  H   |  J   |  K   |  L   |  ;   |C-Ent |
            // | SHFT |  Z   |  X   |  C   |  V   |  B   |          |  N   |  M   |  ,   |  .   |  /   | SHFT |
            //                      |  -   | LT1  | LT3  |          | LT2   | LT1/BSPDEL |  -   |

            display-name = "Base";
            bindings = <
&trans            &kp Q           &kp W           &kp E            &kp R             &kp T              &kp Y            &kp U              &kp I            &kp O           &kp P                   &kp BSPC
&mt LCTRL ESCAPE  &lhmini LGUI A  &lhmini LALT S  &lhmini LCTRL D  &lhmini LSHIFT F  &lhmini LC(B) G    &rhmini LC(B) H  &rhmini RSHIFT J   &rhmini LCTRL K  &rhmini LALT L  &rhmini LGUI SEMICOLON  &mt RCTRL ENTER
&kp LSHFT         &kp Z           &kp X           &kp C            &kp V             &kp B              &kp N            &kp M              &kp COMMA        &kp DOT         &kp FSLH                &kp RSHFT
                                                  &trans           &lt 1 TAB         &lt 3 RET          &lt 2 SPACE      &lt_bspdel 1 BSPC  &trans
            >;
        };

        // 1: symbols across both halves; reachable from either thumb.

        Sym {
            display-name = "Sym";
            bindings = <
&tog 1			&kp TILDE       &kp AMPERSAND            &kp ASTERISK           &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &kp MINUS		&kp EQUAL				&kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp BACKSLASH  &tog 1
&trans			&trans          &lhmini LEFT_ALT DOLLAR  &lhmini LCTRL PERCENT  &lhmini LSHFT CARET    &trans                 &kp UNDER		&rhmini LSHIFT PLUS		&rhmini LCTRL LBRC  &rhmini LALT RBKT  &rhmini LWIN SQT  &trans
&trans			&trans			&kp EXCLAMATION          &kp AT_SIGN            &kp HASH               &trans                 &trans		&trans					&trans             &trans             &trans         &trans
														&trans					&trans				   &trans				  &trans		&trans					&trans
            >;
        };

        // 2: numpad (left) + arrows/mouse (right).

        cursornum {
            display-name = "curnum";
            bindings = <
&tog 2  &kp GRAVE  &kp N7                 &kp N8            &kp N9                  &kp N0       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_UP    &tog 2
&trans  &trans     &lhmini LALT NUMBER_4  &lhmini LCTRL N5  &lhmini LSHFT NUMBER_6  &kp MINUS    &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &trans          &trans
&trans  &trans     &kp NUMBER_1           &kp NUMBER_2      &kp NUMBER_3            &kp EQUAL    &kp HOME        &kp PG_DN       &kp PG_UP     &kp END          &msc SCRL_DOWN  &trans
                                          &trans            &mkp MB1                &mkp MB2     &mkp MB1        &mkp MB2        &trans
            >;
        };

        // 3: F-keys, mirrored on both halves.
        // SYSREQ/SCROLLLOCK/PSCRN kept on the right outer column (no lily
        // equivalent there; drop them if you want byte-for-byte parity).

        funcr {
            display-name = "funcright";
            bindings = <
&tog 3  &kp F9               &kp F10          &kp F11           &kp F12            &trans    &kp F9  &kp F10                &kp F11           &kp F12              &kp SYSREQ                   &tog 3
&trans  &lhmini LEFT_WIN F5  &lhmini LALT F6  &lhmini LCTRL F7  &lhmini LSHIFT F8  &trans    &kp F5  &rhmini LEFT_SHIFT F6  &rhmini LCTRL F7  &rhmini LEFT_ALT F8  &rhmini LEFT_WIN SCROLLLOCK  &trans
&trans  &kp F1               &kp F2           &kp F3            &kp F4             &trans    &kp F1  &kp F2                 &kp F3            &kp F4               &kp PSCRN                    &trans
                                              &trans            &trans             &trans    &trans  &trans                 &trans
            >;
        };
    };
};
